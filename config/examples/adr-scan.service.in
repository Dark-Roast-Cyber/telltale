[Unit]
Description=Telltale one-shot agent session scan
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__STATE_DIR__
Environment=ADR_LOG_PATH=__LOG_PATH__
Environment=ADR_STATE_PATH=__STATE_PATH__
Environment=ADR_SCAN_ROOT=__SCAN_ROOT__
EnvironmentFile=-__ENV_FILE__
ExecStart=__BINDIR__/adr scan --once --emit-activity --root ${ADR_SCAN_ROOT} --path-profile system
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=__LOG_DIR__ __STATE_DIR__

[Install]
WantedBy=default.target

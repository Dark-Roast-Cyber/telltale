#!/usr/bin/env bash
#
# Telltale Linux installer — user-first, sudo-free by default.
#
# Canonical source:
#   https://github.com/Dark-Roast-Cyber/telltale/blob/main/scripts/install-telltale
# Hosted copy:
#   https://agentarchaeology.ai/telltale_install.sh
#
# Usage:
#   curl -fsSL https://agentarchaeology.ai/telltale_install.sh | bash
#   curl -fsSL https://agentarchaeology.ai/telltale_install.sh | bash -s -- --with-timer
#   ./scripts/install-telltale [--from-source] [--install-dir DIR] [--with-timer] [--skip-checksum]
#
# What it does:
#   1. Downloads the latest telltale release for your Linux arch from GitHub releases.
#   2. Verifies the archive against the release's published SHA256SUMS.
#   3. Installs telltale and the adr compatibility command to ~/.local/bin.
#   4. With --with-timer, installs a user-level systemd timer for periodic scans.
#   5. Prints the default telemetry path and next steps.
#
# What it does NOT do:
#   - No sudo, no root, no system user/group creation.
#   - No service or timer setup unless you pass --with-timer.
#   - No SIEM/shipper configuration (Splunk UF, Filebeat, etc. are separate products).
#   - No system-profile setup (see config/examples/ for advanced managed deployments).
#
# Self-versioning:
#   The installer prints INSTALLER_VERSION and INSTALLER_COMMIT at startup so
#   stale hosted copies are easy to detect. When syncing this script to the
#   hosted copy, update INSTALLER_COMMIT to the public Telltale repo commit it
#   was synced from. Bump INSTALLER_VERSION when behavior changes.

set -euo pipefail

REPO="Dark-Roast-Cyber/telltale"
INSTALL_DIR="${HOME}/.local/bin"
FROM_SOURCE=0
WITH_TIMER=0
SKIP_CHECKSUM=0
API_URL="https://api.github.com/repos/${REPO}/releases/latest"
RELEASE_BASE_URL="https://github.com/${REPO}/releases/download"

# Installer self-identification. Update INSTALLER_COMMIT when syncing to the
# hosted copy; bump INSTALLER_VERSION when installer behavior changes.
INSTALLER_VERSION="2026.07.21"
INSTALLER_COMMIT="b67619045aa6"

info()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn()  { printf '\033[1;33m==>\033[0m %s\n' "$*" >&2; }
error() { printf '\033[1;31m==>\033[0m %s\n' "$*" >&2; }
die()   { error "$*"; exit 1; }

print_version() {
    printf 'telltale-installer %s (from %s@%s)\n' \
        "$INSTALLER_VERSION" "$REPO" "$INSTALLER_COMMIT"
}

print_help() {
    cat <<'EOF'
Telltale Linux installer — user-first, sudo-free by default.

Usage:
  curl -fsSL https://agentarchaeology.ai/telltale_install.sh | bash
  curl -fsSL https://agentarchaeology.ai/telltale_install.sh | bash -s -- --with-timer
  ./scripts/install-telltale [--from-source] [--install-dir DIR] [--with-timer] [--skip-checksum]

Options:
  --from-source       Build the exact latest release tag with cargo.
  --install-dir DIR  Install telltale and adr into DIR.
  --with-timer        Install and enable the user adr-scan.timer.
  --no-timer          Do not configure a timer.
  --skip-checksum     Explicitly bypass SHA256SUMS verification.
  --version, -V       Print installer version information.
  --help, -h          Print this help.
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --from-source)  FROM_SOURCE=1; shift ;;
        --install-dir)
            [[ $# -ge 2 ]] || die "--install-dir requires a directory"
            INSTALL_DIR="$2"
            shift 2
            ;;
        --with-timer)   WITH_TIMER=1; shift ;;
        # Historical default was timer-on; accepted for compatibility.
        --no-timer)     WITH_TIMER=0; shift ;;
        --skip-checksum) SKIP_CHECKSUM=1; shift ;;
        --version|-V)   print_version; exit 0 ;;
        --help|-h)
            print_help
            exit 0
            ;;
        *) die "Unknown option: $1" ;;
    esac
done

if [[ "$WITH_TIMER" -eq 1 && "$INSTALL_DIR" != /* ]]; then
    die "--with-timer requires an absolute --install-dir"
fi

info "Telltale installer ${INSTALLER_VERSION} (from ${REPO}@${INSTALLER_COMMIT})"

# --- detect architecture -----------------------------------------------------

arch="$(uname -m)"
case "$arch" in
    x86_64|amd64)   target="x86_64-unknown-linux-gnu" ;;
    aarch64|arm64)  target="aarch64-unknown-linux-gnu" ;;
    *) die "Unsupported Linux architecture: $arch" ;;
esac

info "Detected Linux ${arch} → ${target}"

download_to() {
    local url="$1" destination="$2"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL -o "$destination" "$url"
    elif command -v wget >/dev/null 2>&1; then
        wget -qO "$destination" "$url"
    else
        die "Neither curl nor wget found. Install one, or use --from-source with a downloader available"
    fi
}

download_stdout() {
    local url="$1"
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$url"
    elif command -v wget >/dev/null 2>&1; then
        wget -qO- "$url"
    else
        die "Neither curl nor wget found. Install one, or use --from-source with a downloader available"
    fi
}

release_json=""
if ! release_json="$(download_stdout "$API_URL")"; then
    die "Could not fetch latest release metadata"
fi
[[ -n "$release_json" ]] || die "Latest release metadata was empty"

version_tag="$(printf '%s' "$release_json" \
    | tr '\r\n' '  ' \
    | grep -o '"tag_name"[[:space:]]*:[[:space:]]*"[^"]*"' \
    | sed -n '1s/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)"/\1/p' || true)"
[[ -n "$version_tag" ]] || die "Latest release metadata did not contain an exact tag"
if [[ ! "$version_tag" =~ ^v[0-9]+(\.[0-9]+)*([.-][0-9A-Za-z]+)*$ ]]; then
    die "Latest release tag is not a supported version tag"
fi
expected_version="${version_tag#v}"

tmpdir="$(mktemp -d)"
install_stage_dir=""
unit_stage_dir=""
cleanup() {
    [[ -z "$install_stage_dir" ]] || rm -rf -- "$install_stage_dir"
    [[ -z "$unit_stage_dir" ]] || rm -rf -- "$unit_stage_dir"
    rm -rf -- "$tmpdir"
}
trap cleanup EXIT

# --- checksum verification ---------------------------------------------------

verify_checksum() {
    local archive="$1" archive_name="$2" tmpdir_for_checksums="$3"

    if [[ "$SKIP_CHECKSUM" -eq 1 ]]; then
        warn "Skipping checksum verification (--skip-checksum passed)."
        return 0
    fi

    local sums_url="${RELEASE_BASE_URL}/${version_tag}/SHA256SUMS"
    local sums_file="${tmpdir_for_checksums}/SHA256SUMS"
    if ! download_to "$sums_url" "$sums_file"; then
        die "Could not fetch SHA256SUMS for ${version_tag}; use --skip-checksum only if this is intentional"
    fi
    [[ -s "$sums_file" ]] || die "SHA256SUMS for ${version_tag} was empty; use --skip-checksum only if this is intentional"

    local expected
    if ! expected="$(awk -v name="$archive_name" '$2 == name || $2 == "*" name { print $1; found=1; exit } END { if (!found) exit 1 }' "$sums_file")"; then
        die "No exact SHA256SUMS entry for ${archive_name}; use --skip-checksum only if this is intentional"
    fi
    [[ "$expected" =~ ^[[:xdigit:]]{64}$ ]] || die "Invalid SHA256SUMS entry for ${archive_name}"

    local actual
    if command -v sha256sum >/dev/null 2>&1; then
        if ! actual="$(sha256sum "$archive" | awk '{print $1}')"; then
            die "Could not calculate SHA256 for ${archive_name}"
        fi
    elif command -v shasum >/dev/null 2>&1; then
        if ! actual="$(shasum -a 256 "$archive" | awk '{print $1}')"; then
            die "Could not calculate SHA256 for ${archive_name}"
        fi
    else
        die "Neither sha256sum nor shasum is available; use --skip-checksum only if this is intentional"
    fi

    [[ "$expected" == "$actual" ]] || die "Checksum mismatch for ${archive_name}"
    info "Checksum verified: ${archive_name}"
}

verify_binary() {
    local binary="$1" invocation="$2" allow_legacy_adr="${3:-0}"
    [[ -f "$binary" && ! -L "$binary" ]] || die "Required binary is missing: ${binary}"

    local version_output prefix
    if ! version_output="$("$binary" --version 2>/dev/null)"; then
        die "Binary failed version verification: ${binary}"
    fi

    prefix="${invocation} ${expected_version}"
    case "$version_output" in
        "$prefix"|"$prefix "*|"$prefix"$'\n'*) return 0 ;;
    esac
    if [[ "$allow_legacy_adr" -eq 1 ]]; then
        prefix="adr ${expected_version}"
        case "$version_output" in
            "$prefix"|"$prefix "*|"$prefix"$'\n'*) return 0 ;;
        esac
    fi
    die "Binary version does not match ${invocation} ${version_tag}: ${binary}"
}

# --- stage the binaries ------------------------------------------------------

staged_dir="${tmpdir}/staged"
mkdir -p "$staged_dir"
legacy_bootstrap=0

if [[ "$FROM_SOURCE" -eq 1 ]]; then
    info "Building exact release ${version_tag} from source with cargo (requires Rust toolchain)..."
    command -v cargo >/dev/null 2>&1 || die "cargo not found. Install Rust from https://rustup.rs"
    source_root="${tmpdir}/cargo-root"
    if ! cargo install --git "https://github.com/${REPO}" \
        --tag "$version_tag" --root "$source_root" --force --locked --bins; then
        die "cargo install failed for release ${version_tag}"
    fi
    [[ -f "${source_root}/bin/adr" && ! -L "${source_root}/bin/adr" ]] \
        || die "Source release ${version_tag} did not produce adr"
    if [[ -L "${source_root}/bin/telltale" ]]; then
        die "Source release ${version_tag} produced an invalid telltale link"
    elif [[ ! -e "${source_root}/bin/telltale" && "$version_tag" == "v0.1.0" ]]; then
        legacy_bootstrap=1
        install -m 0755 "${source_root}/bin/adr" "${staged_dir}/adr"
        install -m 0755 "${source_root}/bin/adr" "${staged_dir}/telltale"
    else
        [[ -f "${source_root}/bin/telltale" ]] \
            || die "Source release ${version_tag} did not produce telltale"
        install -m 0755 "${source_root}/bin/telltale" "${staged_dir}/telltale"
        install -m 0755 "${source_root}/bin/adr" "${staged_dir}/adr"
    fi
else
    canonical_name="telltale-${version_tag}-${target}.tar.gz"
    legacy_name="adr-${version_tag}-${target}.tar.gz"
    selected_name="$canonical_name"
    selected_kind="canonical"
    archive="${tmpdir}/${selected_name}"
    info "Downloading Telltale ${version_tag} for ${target}..."
    if ! download_to "${RELEASE_BASE_URL}/${version_tag}/${canonical_name}" "$archive"; then
        selected_name="$legacy_name"
        selected_kind="legacy"
        archive="${tmpdir}/${selected_name}"
        if ! download_to "${RELEASE_BASE_URL}/${version_tag}/${legacy_name}" "$archive"; then
            die "No exact release asset for ${target}: expected ${canonical_name} or ${legacy_name}"
        fi
    fi
    [[ -s "$archive" ]] || die "Downloaded release asset ${selected_name} was empty"
    verify_checksum "$archive" "$selected_name" "$tmpdir"

    archive_members=""
    if ! archive_members="$(tar tzf "$archive")"; then
        die "Could not inspect release asset ${selected_name}"
    fi
    archive_listing=""
    if ! archive_listing="$(tar tvzf "$archive")"; then
        die "Could not inspect release asset types ${selected_name}"
    fi
    while IFS= read -r member; do
        [[ -n "$member" ]] || continue
        [[ "$member" != /* ]] || die "Release asset ${selected_name} contains an absolute path"
        case "/${member}/" in
            */../*) die "Release asset ${selected_name} contains path traversal" ;;
        esac
    done <<< "$archive_members"
    while IFS= read -r listing_line; do
        [[ -n "$listing_line" ]] || continue
        case "${listing_line:0:1}" in
            l|h) die "Release asset ${selected_name} contains a link" ;;
        esac
    done <<< "$archive_listing"

    has_telltale=0
    has_adr=0
    while IFS= read -r member; do
        case "$member" in
            telltale) has_telltale=1 ;;
            adr) has_adr=1 ;;
        esac
    done <<< "$archive_members"
    [[ "$has_adr" -eq 1 ]] || die "Release asset ${selected_name} is missing adr"
    if [[ "$selected_kind" == "canonical" ]]; then
        [[ "$has_telltale" -eq 1 ]] || die "Release asset ${selected_name} is missing telltale"
    elif [[ "$has_telltale" -eq 0 && "$version_tag" != "v0.1.0" ]]; then
        die "Legacy release asset ${selected_name} without telltale is supported only for v0.1.0"
    fi
    if [[ "$has_telltale" -eq 1 ]]; then
        telltale_type="$(printf '%s\n' "$archive_listing" | awk '$NF == "telltale" { type=substr($0, 1, 1); count++ } END { if (count != 1) exit 1; print type }')" \
            || die "Release asset ${selected_name} has an invalid telltale member"
        [[ "$telltale_type" == "-" ]] || die "Release asset ${selected_name} has a non-regular telltale member"
    fi
    adr_type="$(printf '%s\n' "$archive_listing" | awk '$NF == "adr" { type=substr($0, 1, 1); count++ } END { if (count != 1) exit 1; print type }')" \
        || die "Release asset ${selected_name} has an invalid adr member"
    [[ "$adr_type" == "-" ]] || die "Release asset ${selected_name} has a non-regular adr member"

    extract_dir="${tmpdir}/extract"
    mkdir -p "$extract_dir"
    extract_members=(adr)
    if [[ "$has_telltale" -eq 1 ]]; then
        extract_members+=(telltale)
    fi
    if ! tar xzf "$archive" -C "$extract_dir" --no-same-owner -- "${extract_members[@]}"; then
        die "Could not extract release asset ${selected_name}"
    fi

    legacy_bootstrap=0
    if [[ "$selected_kind" == "legacy" && "$has_telltale" -eq 0 ]]; then
        # v0.1-style assets contained only adr. Keep this compatibility path
        # conditional on the legacy asset actually lacking telltale.
        legacy_bootstrap=1
        install -m 0755 "${extract_dir}/adr" "${staged_dir}/adr"
        install -m 0755 "${extract_dir}/adr" "${staged_dir}/telltale"
    else
        install -m 0755 "${extract_dir}/telltale" "${staged_dir}/telltale"
        install -m 0755 "${extract_dir}/adr" "${staged_dir}/adr"
    fi
fi

verify_binary "${staged_dir}/telltale" telltale "$legacy_bootstrap"
verify_binary "${staged_dir}/adr" adr

# --- replace the installation only after staging and validation -------------

[[ ! -L "$INSTALL_DIR" ]] || die "Refusing symlink install directory ${INSTALL_DIR}"
[[ ! -L "${INSTALL_DIR}/telltale" ]] || die "Refusing to replace symlink ${INSTALL_DIR}/telltale"
[[ ! -L "${INSTALL_DIR}/adr" ]] || die "Refusing to replace symlink ${INSTALL_DIR}/adr"
mkdir -p "$INSTALL_DIR"
install_stage_dir="$(mktemp -d "${INSTALL_DIR}/.telltale-install.XXXXXX")"
install -m 0755 "${staged_dir}/telltale" "${install_stage_dir}/telltale.new"
install -m 0755 "${staged_dir}/adr" "${install_stage_dir}/adr.new"
verify_binary "${install_stage_dir}/telltale.new" telltale "$legacy_bootstrap"
verify_binary "${install_stage_dir}/adr.new" adr

old_telltale=0
old_adr=0
telltale_new_attempted=0
adr_new_attempted=0
replacement_active=1
rollback_installation() {
    if [[ "$old_telltale" -eq 1 && -e "${install_stage_dir}/telltale.old" ]]; then
        rm -f -- "${INSTALL_DIR}/telltale" || true
        mv -- "${install_stage_dir}/telltale.old" "${INSTALL_DIR}/telltale" || true
    elif [[ "$telltale_new_attempted" -eq 1 ]]; then
        rm -f -- "${INSTALL_DIR}/telltale" || true
    fi
    if [[ "$old_adr" -eq 1 && -e "${install_stage_dir}/adr.old" ]]; then
        rm -f -- "${INSTALL_DIR}/adr" || true
        mv -- "${install_stage_dir}/adr.old" "${INSTALL_DIR}/adr" || true
    elif [[ "$adr_new_attempted" -eq 1 ]]; then
        rm -f -- "${INSTALL_DIR}/adr" || true
    fi
}
trap 'if [[ "$replacement_active" -eq 1 ]]; then rollback_installation; fi; cleanup' EXIT

if [[ -e "${INSTALL_DIR}/telltale" ]]; then
    [[ -f "${INSTALL_DIR}/telltale" ]] || die "Existing telltale installation is not a regular file"
    old_telltale=1
    if ! mv -- "${INSTALL_DIR}/telltale" "${install_stage_dir}/telltale.old"; then
        die "Could not move the existing telltale aside"
    fi
fi
if [[ -e "${INSTALL_DIR}/adr" ]]; then
    [[ -f "${INSTALL_DIR}/adr" ]] || die "Existing adr installation is not a regular file"
    old_adr=1
    if ! mv -- "${INSTALL_DIR}/adr" "${install_stage_dir}/adr.old"; then
        die "Could not move the existing adr aside"
    fi
fi
telltale_new_attempted=1
if ! mv -- "${install_stage_dir}/telltale.new" "${INSTALL_DIR}/telltale"; then
    die "Could not install ${INSTALL_DIR}/telltale"
fi
adr_new_attempted=1
if ! mv -- "${install_stage_dir}/adr.new" "${INSTALL_DIR}/adr"; then
    die "Could not install ${INSTALL_DIR}/adr"
fi
verify_binary "${INSTALL_DIR}/telltale" telltale "$legacy_bootstrap"
verify_binary "${INSTALL_DIR}/adr" adr
replacement_active=0
trap cleanup EXIT

info "Installed telltale and adr ${version_tag} to ${INSTALL_DIR}"

# --- optional user systemd timer --------------------------------------------

systemd_quote_exec_path() {
    local escaped="$1"
    [[ "$escaped" != *$'\n'* && "$escaped" != *$'\r'* ]] \
        || die "Install directory contains a line break and cannot be used in a systemd unit"
    escaped="${escaped//\\/\\\\}"
    escaped="${escaped//\"/\\\"}"
    escaped="${escaped//%/%%}"
    printf '"%s"' "$escaped"
}

setup_timer() {
    command -v systemctl >/dev/null 2>&1 \
        || die "--with-timer requires systemctl; install systemd or omit --with-timer"

    local unit_dir="${HOME}/.config/systemd/user"
    local service_file="${unit_dir}/adr-scan.service"
    local timer_file="${unit_dir}/adr-scan.timer"
    local exec_start
    local previous_enabled=0 previous_active=0
    if ! mkdir -p "$unit_dir"; then
        die "Could not create user systemd unit directory ${unit_dir}"
    fi
    [[ ! -L "$unit_dir" ]] || die "Refusing symlink user systemd unit directory ${unit_dir}"
    [[ ! -L "$service_file" ]] || die "Refusing symlink ${service_file}"
    [[ ! -L "$timer_file" ]] || die "Refusing symlink ${timer_file}"
    [[ ! -e "$service_file" || -f "$service_file" ]] \
        || die "Existing ${service_file} is not a regular file"
    [[ ! -e "$timer_file" || -f "$timer_file" ]] \
        || die "Existing ${timer_file} is not a regular file"

    if systemctl --user is-enabled adr-scan.timer >/dev/null 2>&1; then
        previous_enabled=1
    fi
    if systemctl --user is-active adr-scan.timer >/dev/null 2>&1; then
        previous_active=1
    fi

    exec_start="$(systemd_quote_exec_path "${INSTALL_DIR}/telltale")"
    unit_stage_dir="$(mktemp -d "${unit_dir}/.telltale-timer.XXXXXX")"
    local staged_service="${unit_stage_dir}/adr-scan.service.new"
    local staged_timer="${unit_stage_dir}/adr-scan.timer.new"

    if ! cat > "$staged_service" <<EOF
[Unit]
Description=Telltale one-shot agent session scan

[Service]
Type=oneshot
ExecStart=:/usr/bin/env -- ${exec_start} scan --once --emit-activity --root %h
EOF
    then
        die "Could not stage ${service_file}"
    fi
    chmod 0644 "$staged_service"

    if ! cat > "$staged_timer" <<EOF
[Unit]
Description=Run Telltale scan periodically

[Timer]
OnBootSec=5min
OnUnitActiveSec=30min
Unit=adr-scan.service

[Install]
WantedBy=timers.target
EOF
    then
        die "Could not stage ${timer_file}"
    fi
    chmod 0644 "$staged_timer"

    local old_service=0 old_timer=0
    local service_new_attempted=0 timer_new_attempted=0
    timer_transaction_active=1
    rollback_timer() {
        if [[ "$old_service" -eq 1 && -e "${unit_stage_dir}/adr-scan.service.old" ]]; then
            rm -f -- "$service_file" || true
            mv -- "${unit_stage_dir}/adr-scan.service.old" "$service_file" || true
        elif [[ "$service_new_attempted" -eq 1 ]]; then
            rm -f -- "$service_file" || true
        fi
        if [[ "$old_timer" -eq 1 && -e "${unit_stage_dir}/adr-scan.timer.old" ]]; then
            rm -f -- "$timer_file" || true
            mv -- "${unit_stage_dir}/adr-scan.timer.old" "$timer_file" || true
        elif [[ "$timer_new_attempted" -eq 1 ]]; then
            rm -f -- "$timer_file" || true
        fi
        systemctl --user daemon-reload >/dev/null 2>&1 || true
        if [[ "$previous_enabled" -eq 1 ]]; then
            systemctl --user enable adr-scan.timer >/dev/null 2>&1 || true
        else
            systemctl --user disable adr-scan.timer >/dev/null 2>&1 || true
        fi
        if [[ "$previous_active" -eq 1 ]]; then
            systemctl --user start adr-scan.timer >/dev/null 2>&1 || true
        else
            systemctl --user stop adr-scan.timer >/dev/null 2>&1 || true
        fi
    }
    trap 'if [[ "$timer_transaction_active" -eq 1 ]]; then rollback_timer; fi; cleanup' EXIT

    if [[ -e "$service_file" ]]; then
        old_service=1
        if ! mv -- "$service_file" "${unit_stage_dir}/adr-scan.service.old"; then
            die "Could not snapshot ${service_file}"
        fi
    fi
    if [[ -e "$timer_file" ]]; then
        old_timer=1
        if ! mv -- "$timer_file" "${unit_stage_dir}/adr-scan.timer.old"; then
            die "Could not snapshot ${timer_file}"
        fi
    fi
    service_new_attempted=1
    if ! mv -- "$staged_service" "$service_file"; then
        die "Could not install ${service_file}"
    fi
    timer_new_attempted=1
    if ! mv -- "$staged_timer" "$timer_file"; then
        die "Could not install ${timer_file}"
    fi

    if ! systemctl --user daemon-reload; then
        die "Could not reload the user systemd manager; binaries were installed, but timer setup failed and previous state restoration was attempted"
    fi
    if ! systemctl --user enable --now adr-scan.timer; then
        die "Could not enable adr-scan.timer; binaries were installed, but timer setup failed and previous state restoration was attempted"
    fi
    timer_transaction_active=0
    trap cleanup EXIT
    info "Installed user systemd timer (runs every 30 min as your user)"
    info "  Manage with: systemctl --user status adr-scan.timer"
    info "  Disable with: systemctl --user disable --now adr-scan.timer"
}

if [[ "$WITH_TIMER" -eq 1 ]]; then
    setup_timer
fi

# --- PATH check + next steps -------------------------------------------------

info ""
info "Telltale installed to: ${INSTALL_DIR}/telltale"
info "Compatibility command installed to: ${INSTALL_DIR}/adr"
if [[ ":${PATH}:" != *":${INSTALL_DIR}:"* ]]; then
    warn "${INSTALL_DIR} is not on your PATH."
    warn "Add this to your shell profile and restart your shell:"
    warn "  export PATH=\"${INSTALL_DIR}:\$PATH\""
fi

info ""
info "Default telemetry path (user profile):"
if [[ -n "${XDG_STATE_HOME:-}" ]]; then
    info "  ${XDG_STATE_HOME}/telltale/logs/adr-events.jsonl"
else
    info "  ${HOME}/.local/state/telltale/logs/adr-events.jsonl"
fi
info ""
info "Next steps:"
info "  telltale scan --once --dry-run --root \$HOME  # read-only first check"
info "  telltale scan --once --emit-activity          # write telemetry"
info "  telltale status                               # review latest summary"
info ""
info "Docs: https://github.com/${REPO}/tree/main/docs"

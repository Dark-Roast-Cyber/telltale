#!/usr/bin/env bash
#
# Telltale Linux installer — user-first, sudo-free by default.
#
# Canonical source:
#   https://github.com/Dark-Roast-Cyber/telltale/blob/main/scripts/install-telltale
# Hosted copy:
#   https://agentarchaeology.ai/telltale_install.sh
#
# Usage:
#   curl -fsSL https://agentarchaeology.ai/telltale_install.sh | bash
#   curl -fsSL https://agentarchaeology.ai/telltale_install.sh | bash -s -- --with-timer
#   ./scripts/install-telltale [--from-source] [--install-dir DIR] [--with-timer] [--skip-checksum]
#
# What it does:
#   1. Downloads the latest adr binary for your Linux arch from GitHub releases.
#   2. Verifies the archive against the release's published SHA256SUMS.
#   3. Installs it to ~/.local/bin/adr (user-writable, no sudo).
#   4. With --with-timer, installs a user-level systemd timer for periodic scans.
#   5. Prints the default telemetry path and next steps.
#
# What it does NOT do:
#   - No sudo, no root, no system user/group creation.
#   - No service or timer setup unless you pass --with-timer.
#   - No SIEM/shipper configuration (Splunk UF, Filebeat, etc. are separate products).
#   - No system-profile setup (see config/examples/ for advanced managed deployments).
#
# Self-versioning:
#   The installer prints INSTALLER_VERSION and INSTALLER_COMMIT at startup so
#   stale hosted copies are easy to detect. When syncing this script to the
#   hosted copy, update INSTALLER_COMMIT to the public Telltale repo commit it
#   was synced from. Bump INSTALLER_VERSION when behavior changes.

set -euo pipefail

REPO="Dark-Roast-Cyber/telltale"
INSTALL_DIR="${HOME}/.local/bin"
FROM_SOURCE=0
WITH_TIMER=0
SKIP_CHECKSUM=0
API_URL="https://api.github.com/repos/${REPO}/releases/latest"

# Installer self-identification. Update INSTALLER_COMMIT when syncing to the
# hosted copy; bump INSTALLER_VERSION when installer behavior changes.
INSTALLER_VERSION="2026.07.20"
INSTALLER_COMMIT="095e642"

info()  { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn()  { printf '\033[1;33m==>\033[0m %s\n' "$*" >&2; }
error() { printf '\033[1;31m==>\033[0m %s\n' "$*" >&2; }
die()   { error "$*"; exit 1; }

print_version() {
    printf 'telltale-installer %s (from %s@%s)\n' \
        "$INSTALLER_VERSION" "$REPO" "$INSTALLER_COMMIT"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --from-source)  FROM_SOURCE=1; shift ;;
        --install-dir)  INSTALL_DIR="$2"; shift 2 ;;
        --with-timer)   WITH_TIMER=1; shift ;;
        # Historical default was timer-on; accepted for compatibility.
        --no-timer)     WITH_TIMER=0; shift ;;
        --skip-checksum) SKIP_CHECKSUM=1; shift ;;
        --version|-V)   print_version; exit 0 ;;
        --help|-h)
            sed -n '2,/^$/p' "$0" | sed 's/^# \?//'
            exit 0
            ;;
        *) die "Unknown option: $1" ;;
    esac
done

info "Telltale installer ${INSTALLER_VERSION} (from ${REPO}@${INSTALLER_COMMIT})"

# --- detect architecture -----------------------------------------------------

arch="$(uname -m)"
case "$arch" in
    x86_64|amd64)   target="x86_64-unknown-linux-gnu" ;;
    aarch64|arm64)  target="aarch64-unknown-linux-gnu" ;;
    *) die "Unsupported Linux architecture: $arch" ;;
esac

info "Detected Linux ${arch} → ${target}"

# --- ensure install dir exists -----------------------------------------------

mkdir -p "$INSTALL_DIR"

# --- checksum verification ---------------------------------------------------

verify_checksum() {
    local archive="$1" archive_name="$2" version_tag="$3" tmpdir="$4"

    if [[ "$SKIP_CHECKSUM" -eq 1 ]]; then
        warn "Skipping checksum verification (--skip-checksum passed)."
        return 0
    fi

    local sums_url="https://github.com/${REPO}/releases/download/${version_tag}/SHA256SUMS"
    local sums_file="${tmpdir}/SHA256SUMS"

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL -o "$sums_file" "$sums_url" 2>/dev/null || true
    else
        wget -qO "$sums_file" "$sums_url" 2>/dev/null || true
    fi

    if [[ ! -s "$sums_file" ]]; then
        warn "Could not fetch SHA256SUMS for ${version_tag}; skipping checksum verification."
        warn "Re-run with --skip-checksum to silence this warning, or verify manually."
        return 0
    fi

    local expected
    expected="$(grep "  ${archive_name}\$" "$sums_file" | awk '{print $1}' || true)"
    if [[ -z "$expected" ]]; then
        warn "No SHA256SUMS entry for ${archive_name}; skipping checksum verification."
        return 0
    fi

    local actual
    if command -v sha256sum >/dev/null 2>&1; then
        actual="$(sha256sum "$archive" | awk '{print $1}')"
    elif command -v shasum >/dev/null 2>&1; then
        actual="$(shasum -a 256 "$archive" | awk '{print $1}')"
    else
        warn "Neither sha256sum nor shasum found; skipping checksum verification."
        return 0
    fi

    if [[ "$expected" != "$actual" ]]; then
        die "Checksum mismatch for ${archive_name}: expected ${expected}, got ${actual}"
    fi
    info "Checksum verified: ${archive_name}"
}

# --- get the binary ----------------------------------------------------------

# cargo install --root <dir> places the binary at <dir>/bin/adr.
# Compute the cargo root so the binary lands at ${INSTALL_DIR}/adr.
if [[ "${INSTALL_DIR##*/}" == "bin" ]]; then
    cargo_root="${INSTALL_DIR%/bin}"
else
    cargo_root="$INSTALL_DIR"
fi

installed_bin=""

if [[ "$FROM_SOURCE" -eq 1 ]]; then
    info "Building from source with cargo (requires Rust toolchain)..."
    command -v cargo >/dev/null 2>&1 || die "cargo not found. Install Rust from https://rustup.rs"
    # cargo install --root <dir> places the binary at <dir>/bin/adr.
    cargo install --git "https://github.com/${REPO}" --root "${cargo_root}" --force
    installed_bin="${cargo_root}/bin/adr"
    # If the cargo bin dir isn't the requested install dir, move the binary.
    if [[ "$(dirname "${installed_bin}")" != "$INSTALL_DIR" ]]; then
        mkdir -p "$INSTALL_DIR"
        install -m 0755 "${installed_bin}" "${INSTALL_DIR}/adr"
        installed_bin="${INSTALL_DIR}/adr"
    fi
    info "Installed adr to ${installed_bin} via cargo"
else
    info "Fetching latest release from GitHub..."
    download_url=""
    version_tag=""

    # Try the GitHub API first.
    if command -v curl >/dev/null 2>&1; then
        release_json="$(curl -fsSL "$API_URL" 2>/dev/null || true)"
    elif command -v wget >/dev/null 2>&1; then
        release_json="$(wget -qO- "$API_URL" 2>/dev/null || true)"
    else
        die "Neither curl nor wget found. Install one, or use --from-source."
    fi

    if [[ -n "$release_json" ]]; then
        version_tag="$(printf '%s' "$release_json" | grep -o '"tag_name": *"[^"]*"' | head -1 | sed 's/.*"tag_name": *"//;s/"$//' || true)"
        # Look for an asset matching our target.
        asset_url="$(printf '%s' "$release_json" | grep -o '"browser_download_url": *"[^"]*"' | grep "${target}" | head -1 | sed 's/.*"browser_download_url": *"//;s/"$//' || true)"
        if [[ -n "$asset_url" ]]; then
            download_url="$asset_url"
        fi
    fi

    if [[ -z "$download_url" ]]; then
        warn "No prebuilt binary found for ${target}."
        warn "Falling back to building from source (requires Rust toolchain)."
        command -v cargo >/dev/null 2>&1 || die "cargo not found. Install Rust from https://rustup.rs"
        cargo install --git "https://github.com/${REPO}" --root "${cargo_root}" --force
        installed_bin="${cargo_root}/bin/adr"
        if [[ "$(dirname "${installed_bin}")" != "$INSTALL_DIR" ]]; then
            mkdir -p "$INSTALL_DIR"
            install -m 0755 "${installed_bin}" "${INSTALL_DIR}/adr"
            installed_bin="${INSTALL_DIR}/adr"
        fi
        info "Installed adr to ${installed_bin} via cargo"
    else
        info "Downloading Telltale ${version_tag} for ${target}..."
        tmpdir="$(mktemp -d)"
        trap 'rm -rf "$tmpdir"' EXIT

        archive_name="$(basename "$download_url")"
        archive="${tmpdir}/${archive_name}"
        if command -v curl >/dev/null 2>&1; then
            curl -fsSL -o "$archive" "$download_url"
        else
            wget -qO "$archive" "$download_url"
        fi

        verify_checksum "$archive" "$archive_name" "$version_tag" "$tmpdir"

        tar xzf "$archive" -C "$tmpdir"
        install -m 0755 "${tmpdir}/adr" "${INSTALL_DIR}/adr"
        installed_bin="${INSTALL_DIR}/adr"
        info "Installed adr ${version_tag} to ${installed_bin}"
    fi
fi

# --- verify the binary runs --------------------------------------------------

adr_bin="$installed_bin"
if ! "$adr_bin" --version >/dev/null 2>&1; then
    die "adr binary at ${adr_bin} did not run. Check your platform and try --from-source."
fi
info "Verified: $(${adr_bin} --version)"

# --- optional user systemd timer ---------------------------------------------

setup_timer() {
    command -v systemctl >/dev/null 2>&1 || { warn "systemctl not found, skipping timer setup."; return 0; }

    local unit_dir="${HOME}/.config/systemd/user"
    mkdir -p "$unit_dir"

    local service_file="${unit_dir}/adr-scan.service"
    local timer_file="${unit_dir}/adr-scan.timer"

    cat > "$service_file" <<EOF
[Unit]
Description=Telltale one-shot agent session scan

[Service]
Type=oneshot
ExecStart=${adr_bin} scan --once --emit-activity --root %h
EOF

    cat > "$timer_file" <<EOF
[Unit]
Description=Run Telltale scan periodically

[Timer]
OnBootSec=5min
OnUnitActiveSec=30min
Unit=adr-scan.service

[Install]
WantedBy=timers.target
EOF

    systemctl --user daemon-reload
    if systemctl --user enable --now adr-scan.timer 2>/dev/null; then
        info "Installed user systemd timer (runs every 30 min as your user)"
        info "  Manage with: systemctl --user status adr-scan.timer"
        info "  Disable with: systemctl --user disable --now adr-scan.timer"
    else
        warn "Could not enable adr-scan.timer. The service files are installed at ~/.config/systemd/user/."
        warn "Enable manually with: systemctl --user enable --now adr-scan.timer"
    fi
}

if [[ "$WITH_TIMER" -eq 1 ]]; then
    setup_timer
fi

# --- PATH check + next steps -------------------------------------------------

info ""
info "Telltale installed to: ${adr_bin}"
if [[ ":${PATH}:" != *":${INSTALL_DIR}:"* ]]; then
    warn "${INSTALL_DIR} is not on your PATH."
    warn "Add this to your shell profile and restart your shell:"
    warn "  export PATH=\"${INSTALL_DIR}:\$PATH\""
fi

info ""
info "Default telemetry path (user profile):"
if [[ -n "${XDG_STATE_HOME:-}" ]]; then
    info "  ${XDG_STATE_HOME}/telltale/logs/adr-events.jsonl"
else
    info "  ${HOME}/.local/state/telltale/logs/adr-events.jsonl"
fi
info ""
info "Next steps:"
info "  adr scan --once --dry-run --root \$HOME  # read-only first check"
info "  adr scan --once --emit-activity          # write telemetry"
info "  adr status                               # review latest summary"
info ""
info "Docs: https://github.com/${REPO}/tree/main/docs"

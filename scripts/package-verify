#!/bin/sh
set -eu

case "$(uname -s)" in
    Linux|Darwin) ;;
    *)
        echo "package verification supports Linux and macOS only" >&2
        exit 77
        ;;
esac

REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
CARGO_BIN=${CARGO:-cargo}
python3 "$REPO_ROOT/scripts/version-consistency-check" --check-publication-order \
    telltale-schema telltale-rules telltale-sources telltale-detect telltale-core telltale-cli
WORKSPACE_METADATA=$(cd "$REPO_ROOT" && "$CARGO_BIN" metadata --locked --no-deps --format-version 1)
VERSION=$(printf '%s' "$WORKSPACE_METADATA" | python3 -c 'import json, sys; metadata = json.load(sys.stdin); print(next(package["version"] for package in metadata["packages"] if package["name"] == "telltale-cli"))')
TARGET_DIR=${CARGO_TARGET_DIR:-$(printf '%s' "$WORKSPACE_METADATA" | python3 -c 'import json, sys; print(json.load(sys.stdin)["target_directory"])')}
mkdir -p "$TARGET_DIR"
TARGET_DIR=$(CDPATH= cd -- "$TARGET_DIR" && pwd -P)
export CARGO_TARGET_DIR="$TARGET_DIR"
WORK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/telltale-package-verify.XXXXXX")
PACKAGE_DIR="$WORK_DIR/packages"
mkdir -p "$PACKAGE_DIR"
DETECT_CONSUMER_DIR="$WORK_DIR/detect-consumer"
DETECT_LIGHT_CONSUMER_DIR="$WORK_DIR/detect-light-consumer"
CORE_CONSUMER_DIR="$WORK_DIR/core-consumer"
CORE_ASSIGNMENT_CONSUMER_DIR="$WORK_DIR/core-assignment-consumer"
SCHEMA_CONSUMER_DIR="$WORK_DIR/schema-consumer"
RULES_CONSUMER_DIR="$WORK_DIR/rules-consumer"
SOURCES_CONSUMER_DIR="$WORK_DIR/sources-consumer"
CLI_CONSUMER_DIR="$WORK_DIR/cli-consumer"
INSTALL_ROOT="$WORK_DIR/install"
START_TIME=$(date +%s)

cleanup() {
    rm -rf "$WORK_DIR"
}
trap cleanup 0 HUP INT TERM

package_path() {
    printf '%s/%s-%s\n' "$PACKAGE_DIR" "$1" "$VERSION"
}

manifest_path() {
    case "$1" in
        telltale-cli) printf '%s/Cargo.toml\n' "$REPO_ROOT" ;;
        telltale-core) printf '%s/crates/telltale/Cargo.toml\n' "$REPO_ROOT" ;;
        *) printf '%s/crates/%s/Cargo.toml\n' "$REPO_ROOT" "$1" ;;
    esac
}

source_path() {
    case "$1" in
        telltale-core) printf '%s/crates/telltale\n' "$REPO_ROOT" ;;
        *) printf '%s/crates/%s\n' "$REPO_ROOT" "$1" ;;
    esac
}

run_package() {
    package=$1
    shift
    dependencies="$*"
    set -- "$CARGO_BIN" package --locked --allow-dirty --manifest-path "$(manifest_path "$package")"
    for dependency in $dependencies; do
        dependency_path=$(source_path "$dependency")
        test -f "$dependency_path/Cargo.toml" || {
            echo "normalized dependency source is missing: $dependency_path" >&2
            exit 1
        }
        set -- "$@" --config "patch.crates-io.$dependency.path=\"$dependency_path\""
    done
    echo "== cargo package $package =="
    (cd "$REPO_ROOT" && CARGO_TARGET_DIR="$TARGET_DIR" "$@")
    normalized_source="$TARGET_DIR/package/$package-$VERSION"
    test -f "$normalized_source/Cargo.toml" || {
        echo "cargo did not produce normalized source for $package" >&2
        exit 1
    }
    cp -R "$normalized_source" "$(package_path "$package")"
}

run_package telltale-schema
run_package telltale-rules telltale-schema
run_package telltale-sources telltale-schema
run_package telltale-detect telltale-schema telltale-rules telltale-sources
run_package telltale-core telltale-schema telltale-rules telltale-sources telltale-detect
run_package telltale-cli telltale-schema telltale-rules telltale-sources telltale-detect telltale-core
test -f "$(package_path telltale-schema)/data/event-3.0.schema.json" || {
    echo "packaged telltale-schema is missing its Event 3.0 schema asset" >&2
    exit 1
}
test -f "$(package_path telltale-schema)/data/event-4.0.schema.json" || {
    echo "packaged telltale-schema is missing its Event 4.0 schema asset" >&2
    exit 1
}
for schema_path in \
    schemas/event.schema.json \
    schemas/historical/README.md \
    schemas/historical/event-1.0.schema.json \
    schemas/historical/event-2.0.schema.json; do
    test -f "$(package_path telltale-cli)/$schema_path" || {
        echo "packaged CLI is missing $schema_path" >&2
        exit 1
    }
done

run_normalized_test() {
    package=$1
    shift
    dependencies="$*"
    set -- "$CARGO_BIN" test --locked --manifest-path "$(package_path "$package")/Cargo.toml"
    for dependency in $dependencies; do
        set -- "$@" --config "patch.crates-io.$dependency.path=\"$(package_path "$dependency")\""
    done
    echo "== normalized cargo test $package =="
    "$@"
}

run_normalized_test telltale-schema
run_normalized_test telltale-rules telltale-schema
run_normalized_test telltale-sources telltale-schema
run_normalized_test telltale-detect telltale-schema telltale-rules telltale-sources
run_normalized_test telltale-core telltale-schema telltale-rules telltale-sources telltale-detect
run_normalized_test telltale-cli telltale-schema telltale-rules telltale-sources telltale-detect telltale-core
echo "Note: workspace integration tests outside package include boundaries remain intentionally excluded."

EMPTY_ROOT="$WORK_DIR/empty-root"
mkdir -p "$EMPTY_ROOT"

set -- "$CARGO_BIN" run --locked --manifest-path "$(package_path telltale-rules)/Cargo.toml" --example evaluate_stream
set -- "$@" --config "patch.crates-io.telltale-schema.path=\"$(package_path telltale-schema)\""
echo "== normalized telltale-rules example =="
"$@" >/dev/null

set -- "$CARGO_BIN" run --locked --manifest-path "$(package_path telltale-core)/Cargo.toml" --example embed_scan
for package in telltale-schema telltale-rules telltale-sources telltale-detect; do
    set -- "$@" --config "patch.crates-io.$package.path=\"$(package_path "$package")\""
done
set -- "$@" -- "$EMPTY_ROOT"
echo "== normalized telltale-core example =="
"$@" >/dev/null

PACKAGED_SHA_FULL=$(python3 - "$(package_path telltale-cli)/.cargo_vcs_info.json" <<'PY'
import json
import re
import sys

sha = json.load(open(sys.argv[1], encoding="utf-8"))["git"]["sha1"]
if not re.fullmatch(r"[0-9a-f]{40}", sha):
    raise SystemExit("packaged VCS sha must be 40 lowercase hex characters")
print(sha)
PY
)
PACKAGED_SHA_PREFIX=$(printf '%.12s' "$PACKAGED_SHA_FULL")

mkdir -p "$DETECT_CONSUMER_DIR/src" "$DETECT_LIGHT_CONSUMER_DIR/src" \
    "$CORE_CONSUMER_DIR/src" "$SCHEMA_CONSUMER_DIR/src" \
    "$RULES_CONSUMER_DIR/src" "$SOURCES_CONSUMER_DIR/src" "$CLI_CONSUMER_DIR/src"
cat > "$DETECT_CONSUMER_DIR/Cargo.toml" <<EOF
[package]
name = "telltale-detect-consumer"
version = "0.0.0"
edition = "2024"

[dependencies]
telltale-detect = "=$VERSION"
EOF

cat > "$DETECT_CONSUMER_DIR/src/main.rs" <<'EOF'
use std::path::Path;

fn main() {
    let _inventory = telltale_detect::mcp::discover_mcp_inventory_servers(Path::new("."));
}
EOF

cat > "$DETECT_LIGHT_CONSUMER_DIR/Cargo.toml" <<EOF
[package]
name = "telltale-detect-light-consumer"
version = "0.0.0"
edition = "2024"

[dependencies]
telltale-detect = { version = "=$VERSION", default-features = false }
telltale-rules = "=$VERSION"
telltale-schema = "=$VERSION"
EOF

cat > "$DETECT_LIGHT_CONSUMER_DIR/src/main.rs" <<'EOF'
use telltale_rules::load_default_rule_set;

fn main() {
    // Detection v2 compiles and evaluates without the default source-io feature.
    let rules = load_default_rule_set().expect("rules");
    let plan = telltale_detect::v2::compile_rule_v1(&rules.compatibility_export())
        .expect("canonical rule compilation");
    let _ = plan.semantic_provenance();
}
EOF

cat > "$CORE_CONSUMER_DIR/Cargo.toml" <<EOF
[package]
name = "telltale-core-consumer"
version = "0.0.0"
edition = "2024"

[features]
protected-assignment = ["telltale-core/protected-assignment", "dep:telltale-schema"]

[dependencies]
telltale-core = "=$VERSION"
telltale-schema = { version = "=$VERSION", optional = true }
EOF

cat > "$CORE_CONSUMER_DIR/src/main.rs" <<'EOF'
use telltale_core::{
    AcquisitionError, ActionFinding, ClientId, DetailedEvaluationOptions, DiscoveryError,
    Event, Event3Record, LocalEventFeed, LocalEventFeedConfig, PipelineError,
    RiskContribution, RiskContributionType, Source, SourceCoverage, SourceFailureStage,
    SourceKind, SourceScanFailure, StartupMode, VisibilityLimit,
};

fn is_discovery_error(error: &PipelineError) -> bool {
    matches!(error, PipelineError::Discovery(DiscoveryError::InvalidRoot { .. }))
}

fn main() {
    let _: Option<Event> = None;
    let _: Option<Event3Record> = None;
    let _: Option<Source> = None;
    let _: Option<ActionFinding> = None;
    let _: Option<DetailedEvaluationOptions> = None;
    let _: Option<SourceCoverage> = None;
    let _: Option<SourceScanFailure> = None;
    let _: Option<SourceFailureStage> = None;
    let _: Option<AcquisitionError> = None;
    let _: Option<VisibilityLimit> = None;
    let _: Option<RiskContribution> = None;
    let _: Option<RiskContributionType> = None;
    let _: fn(&PipelineError) -> bool = is_discovery_error;
    let _: Option<ClientId> = None;
    let _: Option<SourceKind> = None;
    let contribution = RiskContribution::new(
        "rule.consumer",
        RiskContributionType::DeterministicRule,
        1,
        "consumer test",
    )
    .expect("validated contribution");
    assert_eq!(contribution.points(), 1);
    let pipeline = telltale_core::Pipeline::builder().build().expect("pipeline");
    let manifest = pipeline
        .producer_provenance_manifest(&Default::default())
        .expect("producer provenance manifest");
    let manifest_bytes = manifest.to_json_bytes().expect("producer provenance JSON");
    assert!(manifest_bytes.starts_with(b"{\"schema\":\"producer_provenance_manifest\""));
    let missing = std::env::temp_dir().join(format!(
        "telltale-core-consumer-missing-{}",
        std::process::id()
    ));
    let _ = std::fs::remove_dir_all(&missing);
    let error = pipeline.scan_root(&missing).expect_err("missing root");
    assert!(is_discovery_error(&error));
    let feed_path = missing.join("events.jsonl");
    let mut feed = LocalEventFeed::new(LocalEventFeedConfig::new(
        &feed_path,
        StartupMode::Beginning,
    ))
    .expect("local event feed");
    assert!(feed.poll().expect("local event feed poll").records.is_empty());
    #[cfg(feature = "protected-assignment")]
    verify_protected_assignment();
    println!("{}", pipeline.rule_count());
}

#[cfg(feature = "protected-assignment")]
fn verify_protected_assignment() {
    use telltale_core::assignment::{
        AssignmentAdapterDomain, ProtectedAssignmentStore, ReplayAssociation,
    };
    use telltale_schema::observation::{
        CanonicalObservationV2, FactMetadata, Fidelity, IngestionMode, ObservationBody,
        ObservationStage, ObservedAt, SourceProvenance, ToolObservation,
    };

    // Exercise the registered Codex domain with a caller-owned synthetic fact,
    // not Codex acquisition. This locator is immutably attached to that one fact
    // in this test contract; no path, ordinal or semantic matching is used.
    let association = ReplayAssociation::new(
        AssignmentAdapterDomain::registered("codex", "codex.sessions").expect("registered domain"),
        "package-consumer-fact:v1",
        b"synthetic-immutable-fact-a",
    ).expect("association");
    let builder = |name: &str| {
        CanonicalObservationV2::builder(
            ObservationBody::Tool(ToolObservation::new().with_name(name).unwrap()),
            ObservationStage::ToolProposed,
            ObservedAt::new("2026-10-04T00:00:00Z").unwrap(),
            SourceProvenance::new(
                IngestionMode::SessionStore, "codex", "codex.sessions", Fidelity::FullNative,
            ).unwrap(),
        ).fact_metadata("tool.name", FactMetadata::reported().unwrap())
    };
    let root = std::path::PathBuf::from(
        std::env::var_os("TELLTALE_PACKAGE_ASSIGNMENT_ROOT").expect("verifier-owned absent store path"),
    );
    let mut store = ProtectedAssignmentStore::initialize(&root).expect("initialize");
    let first = store.claim_or_replay(builder("synthetic-tool-a"), &association).expect("claim");
    assert!(first.session_id().is_none());
    let id = first.observation_id().to_owned();
    let suffix = id.strip_prefix("obs:v2:sha256:").expect("identity prefix");
    assert_eq!(suffix.len(), 64);
    assert!(suffix.bytes().all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte)));
    let replay = store.claim_or_replay(builder("synthetic-tool-a"), &association).expect("replay");
    assert_eq!(id, replay.observation_id());
    drop(store);
    let mut store = ProtectedAssignmentStore::open(&root).expect("reopen");
    let replay = store.claim_or_replay(builder("synthetic-tool-a"), &association).expect("durable replay");
    assert_eq!(id, replay.observation_id());
    let error = store.claim_or_replay(builder("synthetic-secret-mutation"), &association)
        .expect_err("semantic collision");
    assert_eq!(error.code(), "replay_collision");
    let display = error.to_string();
    let debug = format!("{error:?}");
    for diagnostic in [&display, &debug] {
        assert!(diagnostic.len() <= 128);
        for private in ["synthetic-secret-mutation", "synthetic-immutable-fact-a", &id, root.to_str().unwrap()] {
            assert!(!diagnostic.contains(private));
        }
    }
    let replay = store.claim_or_replay(builder("synthetic-tool-a"), &association).expect("collision preserves assignment");
    assert_eq!(id, replay.observation_id());
    drop(store);
}
EOF

if test "$(uname -s)" = Linux; then
    mkdir -p "$CORE_ASSIGNMENT_CONSUMER_DIR/src"
    cp "$CORE_CONSUMER_DIR/src/main.rs" "$CORE_ASSIGNMENT_CONSUMER_DIR/src/main.rs"
    cat > "$CORE_ASSIGNMENT_CONSUMER_DIR/Cargo.toml" <<EOF
[package]
name = "telltale-core-assignment-consumer"
version = "0.0.0"
edition = "2024"

[features]
protected-assignment = ["telltale-core/protected-assignment"]

[dependencies]
telltale-core = "=$VERSION"
telltale-schema = "=$VERSION"
EOF
fi

cat > "$SCHEMA_CONSUMER_DIR/Cargo.toml" <<EOF
[package]
name = "telltale-schema-consumer"
version = "0.0.0"
edition = "2024"

[dependencies]
telltale-schema = "=$VERSION"
serde_json = "1.0"
EOF

cat > "$SCHEMA_CONSUMER_DIR/src/main.rs" <<'EOF'
use telltale_schema::event::{health_event_with_metadata, Event3Record, HealthEventInput};
use telltale_schema::scoring::RiskThresholds;

fn main() {
    let event = health_event_with_metadata(HealthEventInput {
        sources: &[],
        source_inventory_change: None,
        scan_duration_ms: 0,
        rule_count: 0,
        threshold_config: RiskThresholds {
            low: 20,
            medium: 40,
            high: 60,
            critical: 80,
        },
        active_policy_name: None,
        emitted_count: 0,
        suppressed_count: 0,
        scanner_error_count: 0,
    });
    let bytes = serde_json::to_vec(&event).expect("terminal Event 3.0 bytes");
    let record = Event3Record::from_json(&bytes).expect("typed Event 3.0 consumer");
    assert_eq!(record.event_type(), "health");
    println!("{}", event.telltale_version);
}
EOF

cat > "$RULES_CONSUMER_DIR/Cargo.toml" <<EOF
[package]
name = "telltale-rules-consumer"
version = "0.0.0"
edition = "2024"

[dependencies]
telltale-rules = "=$VERSION"
EOF

cat > "$RULES_CONSUMER_DIR/src/main.rs" <<'EOF'
use telltale_rules::{bundled_default_rule_yaml, load_default_rule_set, CompiledRuleSet, MatchResult};

fn main() {
    let _: Option<CompiledRuleSet> = None;
    let _: Option<MatchResult> = None;
    assert!(!bundled_default_rule_yaml().is_empty());
    let rules = load_default_rule_set().expect("rules");
    assert!(rules.compatibility_export().fingerprint().starts_with("sha256:"));
}
EOF

cat > "$SOURCES_CONSUMER_DIR/Cargo.toml" <<EOF
[package]
name = "telltale-sources-consumer"
version = "0.0.0"
edition = "2024"

[dependencies]
telltale-schema = "=$VERSION"
telltale-sources = "=$VERSION"
EOF

cat > "$SOURCES_CONSUMER_DIR/src/main.rs" <<'EOF'
use std::path::Path;

use telltale_schema::clients::{ClientId, SourceKind};
use telltale_schema::record::RecordKind;
use telltale_schema::source::Source;
use telltale_sources::clients::{PathRoot, SourcePattern};

fn main() {
    let _: Option<ClientId> = None;
    let _: Option<SourceKind> = None;
    let _: Option<RecordKind> = None;
    let _: Option<Source> = None;
    let _ = match ClientId::Codex {
        ClientId::Codex => "codex",
        _ => "other client",
    };
    let _ = match SourceKind::Jsonl {
        SourceKind::Jsonl => "jsonl",
        _ => "other source kind",
    };
    let _ = match RecordKind::ToolCall {
        RecordKind::ToolCall => "tool call",
        _ => "other record kind",
    };
    let _ = match PathRoot::Home {
        PathRoot::Home => "home",
        _ => "other path root",
    };
    let _ = match SourcePattern::ExactFile("session.jsonl") {
        SourcePattern::ExactFile(_) => "exact file",
        _ => "other source pattern",
    };
    let _ = telltale_sources::clients::supported_clients();
    let _ = telltale_sources::discovery::discover_sources(Path::new("."));
}
EOF

cat > "$CLI_CONSUMER_DIR/Cargo.toml" <<EOF
[package]
name = "telltale-cli-consumer"
version = "0.0.0"
edition = "2024"

[dependencies]
telltale-cli = "=$VERSION"
EOF

cat > "$CLI_CONSUMER_DIR/src/main.rs" <<'EOF'
fn main() {
    let _: fn() -> Result<(), Box<dyn std::error::Error>> = telltale_cli::run;
}
EOF

set -- "$CARGO_BIN" run --manifest-path "$SCHEMA_CONSUMER_DIR/Cargo.toml"
set -- "$@" --config "patch.crates-io.telltale-schema.path=\"$(package_path telltale-schema)\""
echo "== registry-style schema consumer =="
schema_version=$("$@")
case "$schema_version" in
    "$VERSION") ;;
    *) echo "unexpected schema provenance: $schema_version" >&2; exit 1 ;;
esac

set -- "$CARGO_BIN" check --manifest-path "$DETECT_CONSUMER_DIR/Cargo.toml"
set -- "$@" --config "patch.crates-io.telltale-detect.path=\"$(package_path telltale-detect)\""
for package in telltale-schema telltale-rules telltale-sources; do
    set -- "$@" --config "patch.crates-io.$package.path=\"$(package_path "$package")\""
done
echo "== registry-style detect-only consumer =="
"$@"

set -- "$CARGO_BIN" check --manifest-path "$DETECT_LIGHT_CONSUMER_DIR/Cargo.toml"
for package in telltale-detect telltale-rules telltale-schema; do
    set -- "$@" --config "patch.crates-io.$package.path=\"$(package_path "$package")\""
done
echo "== registry-style detect no-default-features consumer =="
"$@"

LIGHT_METADATA="$WORK_DIR/detect-light-metadata.json"
set -- "$CARGO_BIN" metadata --format-version 1 --no-default-features \
    --manifest-path "$DETECT_LIGHT_CONSUMER_DIR/Cargo.toml"
for package in telltale-detect telltale-rules telltale-schema; do
    set -- "$@" --config "patch.crates-io.$package.path=\"$(package_path "$package")\""
done
echo "== inspect detect no-default-features dependency graph =="
"$@" > "$LIGHT_METADATA"
python3 - "$LIGHT_METADATA" <<'PY'
import json
import sys

metadata = json.load(open(sys.argv[1], encoding="utf-8"))
names = {package["id"]: package["name"] for package in metadata["packages"]}
nodes = {node["id"]: node for node in metadata["resolve"]["nodes"]}
root = next(package["id"] for package in metadata["packages"]
            if package["name"] == "telltale-detect-light-consumer")
reachable = {root}
pending = [root]
while pending:
    current = pending.pop()
    for dependency in nodes[current]["deps"]:
        if any(kind["kind"] in (None, "normal") for kind in dependency["dep_kinds"]):
            package_id = dependency["pkg"]
            if package_id not in reachable:
                reachable.add(package_id)
                pending.append(package_id)

forbidden = {"telltale-sources", "rusqlite", "walkdir"}
present = forbidden.intersection(names[package_id] for package_id in reachable)
if present:
    raise SystemExit(f"light detect graph unexpectedly contains: {sorted(present)}")
print("light detect graph excludes telltale-sources, rusqlite, and walkdir")
PY

set -- "$CARGO_BIN" check --manifest-path "$RULES_CONSUMER_DIR/Cargo.toml"
set -- "$@" --config "patch.crates-io.telltale-rules.path=\"$(package_path telltale-rules)\""
set -- "$@" --config "patch.crates-io.telltale-schema.path=\"$(package_path telltale-schema)\""
echo "== registry-style rules consumer =="
"$@"

set -- "$CARGO_BIN" check --manifest-path "$SOURCES_CONSUMER_DIR/Cargo.toml"
for package in telltale-sources telltale-schema; do
    set -- "$@" --config "patch.crates-io.$package.path=\"$(package_path "$package")\""
done
echo "== registry-style sources consumer =="
"$@"

set -- "$CARGO_BIN" run --manifest-path "$CORE_CONSUMER_DIR/Cargo.toml"
set -- "$@" --config "patch.crates-io.telltale-core.path=\"$(package_path telltale-core)\""
for package in telltale-schema telltale-rules telltale-sources telltale-detect; do
    set -- "$@" --config "patch.crates-io.$package.path=\"$(package_path "$package")\""
done
echo "== registry-style core-only consumer =="
"$@" >/dev/null

if test "$(uname -s)" = Linux; then
    set -- "$CARGO_BIN" run --features protected-assignment --manifest-path "$CORE_ASSIGNMENT_CONSUMER_DIR/Cargo.toml"
    for package in telltale-core telltale-schema telltale-rules telltale-sources telltale-detect; do
        set -- "$@" --config "patch.crates-io.$package.path=\"$(package_path "$package")\""
    done
    echo "== registry-style protected-assignment core consumer (Linux) =="
    TELLTALE_PACKAGE_ASSIGNMENT_ROOT="$WORK_DIR/protected-assignment-store" \
        "$@" >/dev/null
fi

for variant in normal assignment; do
    case "$variant" in
        normal) consumer_dir="$CORE_CONSUMER_DIR" ;;
        assignment)
            test "$(uname -s)" = Linux || continue
            consumer_dir="$CORE_ASSIGNMENT_CONSUMER_DIR"
            ;;
    esac
    set -- "$CARGO_BIN" metadata --format-version 1 --manifest-path "$consumer_dir/Cargo.toml"
    if test "$variant" = assignment; then
        set -- "$@" --features protected-assignment
    fi
    for package in telltale-core telltale-schema telltale-rules telltale-sources telltale-detect; do
        set -- "$@" --config "patch.crates-io.$package.path=\"$(package_path "$package")\""
    done
    "$@" > "$WORK_DIR/core-$variant-metadata.json"
    python3 - "$WORK_DIR/core-$variant-metadata.json" "$variant" <<'PY'
import json
import sys

metadata = json.load(open(sys.argv[1], encoding="utf-8"))
assignment = sys.argv[2] == "assignment"
names = {package["id"]: package["name"] for package in metadata["packages"]}
nodes = {node["id"]: node for node in metadata["resolve"]["nodes"]}
root = metadata["resolve"]["root"]
reachable = {root}
pending = [root]
while pending:
    for dependency in nodes[pending.pop()]["deps"]:
        if any(kind["kind"] in (None, "normal") for kind in dependency["dep_kinds"]):
            package_id = dependency["pkg"]
            if package_id not in reachable:
                reachable.add(package_id)
                pending.append(package_id)
present = {names[package_id] for package_id in reachable}
assert ("rusqlite" in present) == assignment, "core consumer SQLite graph mismatch"
for package_id in reachable:
    if names[package_id] == "telltale-core":
        assert ("protected-assignment" in nodes[package_id]["features"]) == assignment
    if names[package_id] == "telltale-sources":
        assert "opencode-sqlite" not in nodes[package_id]["features"], "assignment enabled acquisition"
print(f"core {sys.argv[2]} feature graph verified")
PY
done

set -- "$CARGO_BIN" check --manifest-path "$CLI_CONSUMER_DIR/Cargo.toml"
set -- "$@" --config "patch.crates-io.telltale-cli.path=\"$(package_path telltale-cli)\""
for package in telltale-schema telltale-rules telltale-sources telltale-detect telltale-core; do
    set -- "$@" --config "patch.crates-io.$package.path=\"$(package_path "$package")\""
done
echo "== registry-style CLI consumer =="
"$@"

set -- "$CARGO_BIN" install --locked --path "$(package_path telltale-cli)" --root "$INSTALL_ROOT"
for package in telltale-schema telltale-rules telltale-sources telltale-detect telltale-core; do
    set -- "$@" --config "patch.crates-io.$package.path=\"$(package_path "$package")\""
done
echo "== packaged telltale-cli install =="
"$@"

expected_binary_count=0
for binary_path in "$INSTALL_ROOT/bin"/*; do
    test -e "$binary_path" || test -L "$binary_path" || continue
    if test "$binary_path" != "$INSTALL_ROOT/bin/telltale" || test -L "$binary_path" || test ! -f "$binary_path" || test ! -x "$binary_path"; then
        echo "packaged install contains an unexpected executable entry: $binary_path" >&2
        exit 1
    fi
    expected_binary_count=$((expected_binary_count + 1))
    version_output=$("$binary_path" --version)
    case "$version_output" in
        "telltale $VERSION ($PACKAGED_SHA_PREFIX)") printf '%s\n' "$version_output" ;;
        *)
            echo "unexpected telltale version output: $version_output" >&2
            exit 1
            ;;
    esac
    provenance_json=$("$binary_path" config provenance --no-local-config)
    PROVENANCE_JSON="$provenance_json" PROVENANCE_VERSION="$VERSION" python3 - <<'PY'
import json
import os
import re

manifest = json.loads(os.environ["PROVENANCE_JSON"])
assert manifest["schema"] == "producer_provenance_manifest"
assert manifest["version"] == 1
assert manifest["telltale_version"] == os.environ["PROVENANCE_VERSION"]
assert re.fullmatch(r"sha256:[0-9a-f]{64}", manifest["producer_manifest_id"])
assert manifest["event3"]["schema_version"] == "3.0"
assert manifest["suppression"]["canonicalization"] == "suppression-v1-effective-v1"
PY
done
test "$expected_binary_count" -eq 1 || {
    echo "packaged install does not contain exactly the canonical executable set" >&2
    exit 1
}

elapsed=$(( $(date +%s) - START_TIME ))
echo "Package verification passed in ${elapsed}s."

#!/bin/sh
set -eu

usage() { echo 'usage: embedding-contract-check [--msrv | --print-msrv]' >&2; exit 2; }
[ "$#" -le 1 ] || usage

# The external consumer declares the embedding crates' rust-version (the MSRV,
# not a CLI promise); --msrv runs it on exactly that toolchain. Its lock holds
# the newest releases that version allows (`make embedding-lock-update`).
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
manifest="$root/tests/embedding-consumer/Cargo.toml"
declared_msrv() {
    msrv=$(sed -n 's/^rust-version = "\(.*\)"$/\1/p' "$manifest")
    case "$msrv" in
        *.*.*) ;;
        *.*) msrv="$msrv.0" ;;
        *) echo "No rust-version in $manifest" >&2; exit 1 ;;
    esac
}
target=embedding-contract-check
case "${1-}" in
    '') ;;
    --print-msrv) declared_msrv; printf '%s\n' "$msrv"; exit 0 ;;
    --msrv)
        declared_msrv
        rustup run "$msrv" cargo --version >/dev/null 2>&1 || {
            echo "Install Rust $msrv before the MSRV check: rustup toolchain install $msrv --profile minimal" >&2
            exit 1
        }
        export RUSTUP_TOOLCHAIN="$msrv"
        target=embedding-msrv-check
        ;;
    *) usage ;;
esac
export CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-"$root/target/$target"}
# Leave temporary storage to the platform default unless the caller selects it.
# A target directory may have writable, non-sticky ancestors unsafe for assignment.
printf 'External embedding contracts: '
cargo --version

for features in '' opencode-sqlite protected-assignment \
    opencode-sqlite,protected-assignment sqlx-sqlite \
    opencode-sqlite,sqlx-sqlite protected-assignment,sqlx-sqlite \
    opencode-sqlite,protected-assignment,sqlx-sqlite
do
    printf '\nEmbedding contract features: %s\n' "${features:-default}"
    set -- --locked --manifest-path "$manifest" --no-default-features
    if [ -n "$features" ]; then
        set -- "$@" --features "$features"
    fi
    case "$features" in
        *sqlx-sqlite*) core_graph=$(cargo tree "$@" --prune sqlx -e normal,build --prefix none -f '{p}') ;;
        *) core_graph=$(cargo tree "$@" -e normal,build --prefix none -f '{p}') ;;
    esac
    case "$features" in
        *opencode-sqlite*|*protected-assignment*)
            printf '%s\n' "$core_graph" | grep -q '^rusqlite v0.32.1'
            ;;
        *)
            if printf '%s\n' "$core_graph" | grep -Eq '^(rusqlite|libsqlite3-sys) '; then
                echo 'Default core unexpectedly depends on SQLite' >&2
                exit 1
            fi
            ;;
    esac
    source_features=$(cargo tree "$@" -e normal,build --prefix none -f '{p} features={f}' | grep '^telltale-sources ')
    case "$features" in
        *opencode-sqlite*) printf '%s\n' "$source_features" | grep -q 'opencode-sqlite' ;;
        *)
            if printf '%s\n' "$source_features" | grep -q 'opencode-sqlite'; then
                echo 'An independent feature enabled OpenCode acquisition' >&2
                exit 1
            fi
            ;;
    esac
    case "$features" in
        *sqlx-sqlite*)
            sqlite_graph=$(cargo tree "$@" -e normal,build --no-dedupe --prefix none -f '{p}' | grep '^libsqlite3-sys ' | sort -u)
            [ "$sqlite_graph" = 'libsqlite3-sys v0.30.1' ] || {
                echo "Unexpected SQLite linkage: $sqlite_graph" >&2
                exit 1
            }
            ;;
    esac
    cargo test "$@"
done

#!/usr/bin/env python3
"""Validate every Event 3.0 JSONL object with Draft 2020-12 JSON Schema.

Requires ``jsonschema[format-nongpl]>=4.18,<5`` including RFC 3339 date-time checks.
CI bootstrap exception: installing this PyPI extra is allowed
on GitHub-hosted runners because ``uv`` is not guaranteed on Windows/macOS
images.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

try:
    from jsonschema import Draft202012Validator, FormatChecker
except ImportError as error:
    raise SystemExit(
        f"jsonschema is required to validate Event 3.0 JSONL: {error}; "
        "install 'jsonschema[format-nongpl]>=4.18,<5'"
    )

# FormatChecker silently accepts an unknown format when its optional backend is
# absent. Even --help must fail preflight rather than advertise a weakened driver.
FORMAT_CHECKER = FormatChecker()
if (
    FORMAT_CHECKER.conforms("not-a-timestamp", "date-time")
    or not FORMAT_CHECKER.conforms("2026-05-01T00:00:00Z", "date-time")
):
    raise SystemExit(
        "Event 3.0 date-time validation requires 'jsonschema[format-nongpl]>=4.18,<5' "
        "with a working RFC 3339 checker"
    )


def fail(message: str) -> int:
    print(message, file=sys.stderr)
    return 1


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--schema", required=True, type=Path)
    parser.add_argument("--events", required=True, type=Path)
    args = parser.parse_args()

    try:
        schema = json.loads(args.schema.read_text(encoding="utf-8"))
        Draft202012Validator.check_schema(schema)
        validator = Draft202012Validator(schema, format_checker=FORMAT_CHECKER)
        with args.events.open(encoding="utf-8") as events:
            lines = events.readlines()
    except (OSError, UnicodeError, json.JSONDecodeError, TypeError, ValueError) as error:
        return fail(f"Could not load Event 3.0 schema or JSONL: {error}")

    if not lines:
        return fail("Event 3.0 JSONL must not be empty")

    for line_number, line in enumerate(lines, start=1):
        try:
            value = json.loads(line)
        except json.JSONDecodeError as error:
            return fail(f"Invalid JSON on line {line_number}: {error}")
        if not isinstance(value, dict):
            return fail(f"Line {line_number} is not a JSON object")
        errors = sorted(validator.iter_errors(value), key=lambda error: list(error.path))
        if errors:
            error = errors[0]
            path = ".".join(str(part) for part in error.path) or "$"
            return fail(f"Schema validation failed on line {line_number} at {path}: {error.message}")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())

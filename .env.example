# Sink secrets referenced from outputs.d configs via `{env: NAME}` entries
# (see config/examples/telltale-outputs.yaml).
SPLUNK_HEC_TOKEN=replace-with-splunk-hec-token
ELASTIC_PASSWORD=replace-with-elastic-password

# Runtime defaults.
TELLTALE_LOG_PATH=logs/telltale-events.jsonl
TELLTALE_STATE_PATH=state/telltale-state.json
# Service-manager interpolation only; direct scans use the --root argument.
# TELLTALE_SCAN_ROOT=.
TELLTALE_RISK_THRESHOLD_LOW=20
TELLTALE_RISK_THRESHOLD_MEDIUM=50
TELLTALE_RISK_THRESHOLD_HIGH=70
TELLTALE_RISK_THRESHOLD_CRITICAL=90

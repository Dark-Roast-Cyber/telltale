# Sink secrets referenced from outputs.d configs via `{env: NAME}` entries
# (see config/examples/telltale-outputs.yaml).
SPLUNK_HEC_TOKEN=replace-with-splunk-hec-token
ELASTIC_PASSWORD=replace-with-elastic-password

# Runtime defaults.
ADR_LOG_PATH=logs/adr-events.jsonl
ADR_STATE_PATH=state/adr-state.json
ADR_SCAN_ROOT=.
ADR_RISK_THRESHOLD_LOW=20
ADR_RISK_THRESHOLD_MEDIUM=50
ADR_RISK_THRESHOLD_TRIAGE=70
ADR_RISK_THRESHOLD_ALERT=90

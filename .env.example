# OpenAI-compatible LiteLLM endpoint used by the triage and guard clients.
LITELLM_API_BASE=https://ai.example.test/api
LITELLM_API_KEY=replace-with-litellm-token

# Optional fallback for demo scripts that instantiate a standard OpenAI client.
OPENAI_API_KEY=replace-with-openai-token

# Default low-cost triage model and guard model.
MODEL=qwen3.5:35b-ctx100k
LLAMA_GUARD_MODEL=openai/llama-guard3:1b

# Runtime defaults.
ADR_LOG_PATH=logs/adr-events.jsonl
ADR_STATE_DIR=state
ADR_SCAN_ROOT=.
ADR_RISK_THRESHOLD_LOW=20
ADR_RISK_THRESHOLD_MEDIUM=50
ADR_RISK_THRESHOLD_TRIAGE=70
ADR_RISK_THRESHOLD_ALERT=90

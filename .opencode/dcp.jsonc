{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  "enabled": true,
  "manualMode": {
    "enabled": false,
    "automaticStrategies": true
  },
  "compress": {
    "mode": "range",
    "permission": "allow",
    "summaryBuffer": true,
    "minContextLimit": "45%",
    "maxContextLimit": "75%",
    "nudgeFrequency": 2,
    "iterationNudgeThreshold": 8,
    "nudgeForce": "strong"
  },
  "protectedFilePatterns": [
    "AGENTS.md",
    ".ai/**"
  ],
  "strategies": {
    "deduplication": {
      "enabled": true
    },
    "purgeErrors": {
      "enabled": true,
      "turns": 4
    }
  }
}

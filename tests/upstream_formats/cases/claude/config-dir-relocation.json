{
  "description": "CLAUDE_CONFIG_DIR moves everything Claude Code writes, including projects/<project>/<session>.jsonl transcripts.",
  "harness": "claude-code",
  "upstream": [
    "https://github.com/anthropics/claude-code/blob/2301018b1f61073c501a8e7a4813ef48c239163b/CHANGELOG.md#L2184",
    "https://code.claude.com/docs/en/env-vars",
    "https://code.claude.com/docs/en/sessions"
  ],
  "status": "supported",
  "discover": {
    "client": "claude",
    "env": {"CLAUDE_CONFIG_DIR": "{home}/relocated-claude"},
    "files": {
      "relocated-claude/projects/-synthetic-work/11111111-2222-4333-8444-555555555552.jsonl": {
        "jsonl": [
          {"type": "user", "uuid": "u1", "sessionId": "11111111-2222-4333-8444-555555555552", "timestamp": "2026-10-13T00:00:01.000Z", "cwd": "/synthetic/work", "message": {"role": "user", "content": "Hello."}},
          {"type": "assistant", "uuid": "m1", "parentUuid": "u1", "sessionId": "11111111-2222-4333-8444-555555555552", "timestamp": "2026-10-13T00:00:02.000Z", "cwd": "/synthetic/work", "message": {"role": "assistant", "model": "claude-synthetic", "content": [{"type": "text", "text": "Hello."}]}}
        ]
      }
    }
  },
  "expect": {
    "selected_sources": 1,
    "min_records": 2
  }
}
